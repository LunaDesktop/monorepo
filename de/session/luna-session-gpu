#!/bin/sh
# PaganOS/Luna: sesja z włączonym GPU.
#
# Wybierz „Luna (GPU)” w menedżerze logowania (albo uruchom `luna-session-gpu`).
# Ustawia LUNA_GPU=1, dzięki czemu Selene ogłasza klientom `zwp_linux_dmabuf_v1`
# i aplikacje GPU (Zed, Electron, Chrome) działają natywnie Waylandem.
# Zwykła sesja „Luna” pozostaje na ścieżce CPU — bezpieczny fallback.
set -eu
export LUNA_GPU=1
exec luna-session "$@"
