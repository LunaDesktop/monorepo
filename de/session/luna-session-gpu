#!/bin/sh
# PaganOS/Luna: sesja z GPU (eksperymentalna).
#
# Domyślna sesja „Luna” zostaje na CPU. Ten wariant ustawia `LUNA_GPU=1`, dzięki
# czemu Selene ogłasza klientom `zwp_linux_dmabuf_v1` i komponuje ich bufory
# sprzętowo. Ścieżka GPU nie jest jeszcze dopracowana na NVIDII (zero-copy bywa
# odrzucane przez sterownik, a układ/mode monitorów wymaga sprawdzenia), dlatego
# jest opcją, a nie domyślnym wyborem.
set -eu
export LUNA_GPU=1
exec luna-session "$@"
