#!/bin/sh
# Sesja środowiska Luna — uruchamia kompozytor Selene.
#
# Domyślnie startujemy na DRM/KMS (własny ekran, bez nadrzędnego kompozytora).
# Gdy master DRM trzyma inna sesja, Selene sam to zgłosi i spadnie do wyjścia
# nested — ustaw wtedy SELENE_BACKEND=nested (albo wyloguj bieżącą sesję).
set -eu

export XDG_CURRENT_DESKTOP=Luna
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Luna

# XDG_RUNTIME_DIR normalnie ustawia menedżer sesji (logind/pam_systemd). Gdy go brak
# (np. pam_systemd nie zdołał założyć sesji), wskazujemy katalog per-uid, żeby Selene
# i klienci mieli gdzie założyć gniazdo Wayland. Selene sam waliduje ten katalog.
if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
    export XDG_RUNTIME_DIR
fi

: "${SELENE_BACKEND:=drm}"
export SELENE_BACKEND

# Tryb DRM nie ma nadrzędnego kompozytora — wejście czytamy wprost z /dev/input
# (wymaga dostępu do urządzeń: grupa `input` albo root).
if [ "$SELENE_BACKEND" = "drm" ]; then
    : "${SELENE_INPUT:=evdev}"
    export SELENE_INPUT
fi

# Diagnostyka wydajności (fps DRM + tempo kursora). Domyślnie wyłączona; włącz
# jednorazowo w otoczeniu, gdy diagnozujesz płynność:  SELENE_STATS=1 luna-session

# Trwały log sesji: LightDM trzyma tylko 2 pliki `.xsession-errors` i obraca je przy
# każdym starcie sesji, przez co logi Luny przepadają. Piszemy do stałego pliku w
# katalogu stanu użytkownika, żeby każdą próbę dało się obejrzeć po fakcie.
log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/luna"
if mkdir -p "$log_dir" 2>/dev/null; then
    log="$log_dir/session.log"
    printf '=== luna-session %s ===\nXDG_RUNTIME_DIR=%s SELENE_BACKEND=%s SELENE_INPUT=%s\n' \
        "$(date -Is)" "${XDG_RUNTIME_DIR:-<brak>}" "$SELENE_BACKEND" "${SELENE_INPUT:-<brak>}" \
        >>"$log" 2>/dev/null || true
    exec >>"$log" 2>&1
fi

# Kompozytor w tle, a po nim powłoka Luna (panel/OSD). Czekamy na gniazdo Wayland.
selene &
selene_pid=$!

# Poczekaj, aż Selene zbindowuje gniazdo (zwykle ułamek sekundy).
i=0
while [ ! -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wayland-0" ] && [ "$i" -lt 50 ]; do
    sleep 0.1
    i=$((i + 1))
done

# Powłoka Luna (panel, launcher, OSD) — o ile jest zainstalowana.
if command -v luna-shell >/dev/null 2>&1; then
    export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
    echo "luna-session: uruchamiam luna-shell ($(command -v luna-shell))"
    luna-shell &
else
    echo "luna-session: brak luna-shell w PATH"
fi

# Sesja żyje, dopóki działa kompozytor.
wait "$selene_pid"
